# Dependencies
node_modules/
.claude
.vscode

# Production builds
dist/
dist-electron/
*.apk
*.zip
# …but the published download must be committed so Vercel can serve it.
!app.apk
!cast.apk
!tv.apk
latest.exe

# Secrets — GitHub token for `npm run release`, etc. Never commit.
.env
.env.local

# Local server database and Xtream credentials cache
server/data/
credentials.json
playlist_cache.json
epg_cache.json

# Android Studio and Gradle settings/caches
.gradle/
.idea/
# Top-level build/ holds electron-builder resources; only installer.nsh is source.
build/*
!build/installer.nsh
# Nested build dirs (Capacitor/Cordova modules) stay fully ignored.
android/**/build/
local.properties
capture/
android/.gradle/
android/app/build/
android/local.properties
android/.idea/

# OS Files
.DS_Store
Thumbs.db

# Generated at build time
public/version.json

# Local binaries for packaging
extraResources/

# Custom Electron codec build — huge upstream checkout + built dist are local-only.
# (The guide, scripts, and ported patches under electron-codecs/ ARE committed.)
electron-codecs/upstream/
electron-codecs/dist/
electron-src/

stream-monitor-out/

# iOS (Capacitor) — the Xcode project is generated on macOS/CI by `cap add ios`.
# The native plugin source lives in ios-native-video/ (committed); the generated
# app project and CocoaPods artifacts are not.
/ios/App/Pods/
/ios/App/App/public/
/ios/App/build/
/ios/DerivedData/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
DerivedData/
*.xcuserstate
